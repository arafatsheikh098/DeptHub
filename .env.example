# Environment: development, test, or production
ENV=development

# Secret key for session cookie signing and CSRF tokens (must change in production!)
SECRET_KEY=insecure-dev-secret-key-change-in-production

# Database URL: SQLite for local dev, PostgreSQL for production
# SQLite: sqlite:///./depthub.db
# PostgreSQL: postgresql+psycopg://depthub:depthub@localhost:5432/depthub
DATABASE_URL=sqlite:///./depthub.db

# Base URL used for Atom feed links and absolute URLs
PUBLIC_BASE_URL=http://localhost:8000

# Timezone for displaying timestamps and computing "Today" routine (default Asia/Dhaka)
TIMEZONE=Asia/Dhaka

# Optional initial admin user credentials (seeded only on initial startup if no admin exists)
ADMIN_EMAIL=admin@dept.university.edu
ADMIN_PASSWORD=change-this-admin-password-123

# Term window dates for recurring .ics calendar feeds (YYYY-MM-DD)
TERM_START=2026-01-01
TERM_END=2026-06-30

# Allowed proxy IPs for uvicorn (defaults to * for containers)
FORWARDED_ALLOW_IPS=*
